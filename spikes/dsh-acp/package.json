{
  "name": "wevir-spike-dsh-acp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "T0.3 一次性验证：Wevir 以 ACP 方式接入 DeepSeek Harness。不属于 pnpm workspace，不进入产品构建。",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "spike": "node src/run-all.ts",
    "spike:mock": "node src/run-all.ts --mock",
    "spike:keyless": "node src/run-all.ts --keyless",
    "check-secrets": "node src/run-all.ts --keyless --only=check-secrets"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/dsh": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-alpha.2"
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.2.1-alpha.2": true,
    "koffi@3.1.1": true,
    "node-pty@1.2.0-beta.15": true,
    "protobufjs@7.6.6": true,
    "@google/genai@2.21.0": true
  }
}
