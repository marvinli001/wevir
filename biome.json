{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!spikes/**/fixtures",
      "!packages/adapter-dsh/src/test-fixtures/acp",
      "!packages/model-gateway/src/test-fixtures/codex-requests",
      "!packages/model-gateway/src/__snapshots__"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@deepseek-ai/**"],
                "message": "引擎边界：只有 packages/adapter-dsh 可以 import @deepseek-ai/*（见 AGENTS.md）。"
              },
              {
                "group": [
                  "@openai/codex",
                  "@openai/codex/**",
                  "@openai/codex-*",
                  "@openai/codex-*/**"
                ],
                "message": "引擎边界：只有 packages/adapter-codex 可以 import @openai/codex*（见 AGENTS.md）。"
              },
              {
                "group": ["**/spikes/**"],
                "message": "spikes/ 是一次性验证代码，产品代码不得引用（见 AGENTS.md）。"
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/adapter-dsh/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@openai/codex",
                      "@openai/codex/**",
                      "@openai/codex-*",
                      "@openai/codex-*/**"
                    ],
                    "message": "引擎边界：只有 packages/adapter-codex 可以 import @openai/codex*（见 AGENTS.md）。"
                  },
                  {
                    "group": ["**/spikes/**"],
                    "message": "spikes/ 是一次性验证代码，产品代码不得引用（见 AGENTS.md）。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/adapter-codex/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@deepseek-ai/**"],
                    "message": "引擎边界：只有 packages/adapter-dsh 可以 import @deepseek-ai/*（见 AGENTS.md）。"
                  },
                  {
                    "group": ["**/spikes/**"],
                    "message": "spikes/ 是一次性验证代码，产品代码不得引用（见 AGENTS.md）。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/adapter-dsh/stream-tap/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@deepseek-ai/**"],
                    "message": "stream-tap 插件在 dsh 进程里运行，只用 Cordis 的 ctx，不 import @deepseek-ai/*（T3.2a，ADR-0001 §3）。"
                  },
                  {
                    "group": [
                      "@openai/codex",
                      "@openai/codex/**",
                      "@openai/codex-*",
                      "@openai/codex-*/**"
                    ],
                    "message": "引擎边界：只有 packages/adapter-codex 可以 import @openai/codex*（见 AGENTS.md）。"
                  },
                  {
                    "group": ["**/spikes/**"],
                    "message": "spikes/ 是一次性验证代码，产品代码不得引用（见 AGENTS.md）。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/client-sdk/src/**",
        "!packages/client-sdk/src/node.ts",
        "!packages/client-sdk/src/**/*.test.ts",
        "!packages/client-sdk/src/test-utils.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/renderer/**",
        "apps/desktop/src/preload/**",
        "apps/desktop/src/shared/**",
        "!apps/desktop/src/**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": ["spikes/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
