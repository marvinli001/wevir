{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!spikes/**/fixtures",
      "!packages/model-gateway/src/test-fixtures/codex-requests",
      "!packages/model-gateway/src/__snapshots__",
      "!assets/icons/source/Wevir.icon"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@openai/codex",
                  "@openai/codex/**",
                  "@openai/codex-*",
                  "@openai/codex-*/**"
                ],
                "message": "引擎边界：只有 packages/adapter-codex 可以 import @openai/codex*（见 AGENTS.md）。"
              },
              {
                "group": [
                  "@anthropic-ai/claude-agent-sdk",
                  "@anthropic-ai/claude-agent-sdk/**",
                  "@anthropic-ai/claude-agent-sdk-*",
                  "@anthropic-ai/claude-code",
                  "@anthropic-ai/claude-code/**"
                ],
                "message": "引擎边界：只有 packages/adapter-claude 可以 import @anthropic-ai/claude-agent-sdk 与 @anthropic-ai/claude-code（见 AGENTS.md）。"
              },
              {
                "group": ["@cursor/sdk", "@cursor/sdk/**", "@cursor/sdk-*", "@cursor/sdk-*/**"],
                "message": "引擎边界：只有 packages/adapter-cursor 可以 import @cursor/sdk*（见 AGENTS.md）。"
              },
              {
                "group": ["@opencode-ai/**", "@opencode/**"],
                "message": "引擎边界：只有 packages/adapter-opencode 可以 import @opencode-ai/* 与 @opencode/*（见 AGENTS.md）。"
              },
              {
                "group": ["**/spikes/**"],
                "message": "spikes/ 是一次性验证代码，产品代码不得引用（见 AGENTS.md）。"
              },
              {
                "group": [
                  "@tencent-ai/codebuddy-code",
                  "@tencent-ai/codebuddy-code/**",
                  "@tencent-ai/codebuddy-code-*",
                  "@tencent-ai/codebuddy-code-*/**",
                  "@tencent-ai/agent-sdk",
                  "@tencent-ai/agent-sdk/**",
                  "@tencent-ai/agent-sdk-*",
                  "@tencent-ai/agent-sdk-*/**"
                ],
                "message": "引擎边界：只有 packages/adapter-workbuddy 可以 import 腾讯 CLI / SDK；用户自己安装，适配器只启动它（见 AGENTS.md）。"
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/adapter-codex/**"],
