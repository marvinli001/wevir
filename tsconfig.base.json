{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    // NodeNext 而非 Bundler：host / adapter-* / cli 直接跑在 Node 上，类型检查要和 Node 的真实
    // 解析规则一致（相对导入写 .js 后缀、严格遵守依赖的 exports）。按 NodeNext 写的代码打包器
    // 也能处理，反之不成立。只走打包器的包（如将来的 desktop renderer）可在自己的 tsconfig 里
    // 改成 "module": "preserve" + "moduleResolution": "bundler"。
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    // 工作区库包的 exports 里第一个条件是 "@wevir/source"，指向 src/*.ts。类型检查认这个条件，
    // 所以依赖其他工作区包时不需要先 pnpm build；Node、打包器和发布出去的包不认它，照常走 dist/。
    // Vitest 对应的设置在各包 vitest.config.ts 的 ssr.resolve.conditions（ADR-0004 补记 1）。
    "customConditions": ["@wevir/source"],
    // 各包按需声明，例如 Node 包写 ["node"]；protocol 这类两端共用的包保持为空。
    "types": [],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "declarationMap": true
  }
}
