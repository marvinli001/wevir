{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 35,
              "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      }
    },
    "featured": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 35,
              "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(?!wevir)[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": ["id", "name", "entries"],
        "additionalProperties": false
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(?!wevir)[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": ["plugin", "mcp", "skill"]
          },
          "path": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^(?!\\.{1,2}(?:\\/|$))[^/\\\\]+(?:\\/(?!\\.{1,2}(?:\\/|$))[^/\\\\]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
          },
          "description": {
            "type": "string",
            "maxLength": 1024
          },
          "i18n": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 35,
              "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "description": {
                  "type": "string",
                  "maxLength": 1024
                }
              },
              "additionalProperties": false
            }
          },
          "author": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string"
              }
            },
            "required": ["name"],
            "additionalProperties": false
          },
          "homepage": {
            "type": "string"
          },
          "license": {
            "type": "string",
            "maxLength": 128
          },
          "icon": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^(?!\\.{1,2}(?:\\/|$))[^/\\\\]+(?:\\/(?!\\.{1,2}(?:\\/|$))[^/\\\\]+)*$"
          },
          "category": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trust": {
            "type": "string",
            "enum": ["official", "community"]
          },
          "requires": {
            "type": "object",
            "properties": {
              "runtimes": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9-]*(?:(?:>=|=)[0-9][0-9A-Za-z.+-]*)?$"
                }
              }
            },
            "additionalProperties": false
          },
          "contents": {
            "type": "object",
            "properties": {
              "connectors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "transport": {
                      "type": "string",
                      "enum": ["stdio", "http"]
                    },
                    "command": {
                      "type": "string"
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": ["name", "transport"],
                  "additionalProperties": false
                }
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": ["name", "description"],
                  "additionalProperties": false
                }
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 1024
                    },
                    "secret": {
                      "type": "boolean"
                    },
                    "required": {
                      "type": "boolean"
                    }
                  },
                  "required": ["key", "label"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["connectors", "skills", "inputs"],
            "additionalProperties": false
          },
          "files": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^(?!\\.{1,2}(?:\\/|$))[^/\\\\]+(?:\\/(?!\\.{1,2}(?:\\/|$))[^/\\\\]+)*$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": ["path", "size", "sha256"],
              "additionalProperties": false
            }
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "history": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              },
              "required": ["version", "commit"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "name",
          "version",
          "trust",
          "contents",
          "files",
          "digest"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "generatedAt",
    "sequence",
    "commit",
    "categories",
    "featured",
    "entries"
  ],
  "additionalProperties": false,
  "title": "Wevir marketplace index (index.json)"
}
