{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?!wevir)[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "icon": {
      "type": "string",
      "maxLength": 512,
      "allOf": [
        {
          "pattern": "^\\.\\/(?:(?!\\.\\.(?:\\/|$))[^/\\\\]+(?:\\/|$))*$"
        },
        {
          "pattern": "\\.(?:png|svg)$"
        }
      ]
    },
    "skills": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^\\.\\/(?:(?!\\.\\.(?:\\/|$))[^/\\\\]+(?:\\/|$))*$"
    },
    "connectors": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 512,
          "pattern": "^\\.\\/(?:(?!\\.\\.(?:\\/|$))[^/\\\\]+(?:\\/|$))*$"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9_-]+$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "transport": {
                    "type": "string",
                    "const": "stdio"
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "cwd": {
                    "type": "string",
                    "minLength": 1
                  },
                  "env": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "toolTimeoutSec": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": ["transport", "command"]
              },
              {
                "type": "object",
                "properties": {
                  "transport": {
                    "type": "string",
                    "const": "http"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "headers": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "toolTimeoutSec": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": ["transport", "url"]
              }
            ]
          }
        }
      ]
    },
    "inputs": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 1024
          },
          "secret": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": ["key", "label"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "id", "name", "version"],
  "additionalProperties": false,
  "title": "Wevir plugin manifest (wevir-plugin.json)"
}
