{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?!wevir)[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "icon": {
      "type": "string",
      "maxLength": 512,
      "allOf": [
        {
          "pattern": "^\\.\\/(?:(?!\\.\\.(?:\\/|$))[^/\\\\]+(?:\\/|$))*$"
        },
        {
          "pattern": "\\.(?:png|svg)$"
        }
      ]
    },
    "skills": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^\\.\\/(?:(?!\\.\\.(?:\\/|$))[^/\\\\]+(?:\\/|$))*$"
    },
    "connectors": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 512,
          "pattern": "^\\.\\/(?:(?!\\.\\.(?:\\/|$))[^/\\\\]+(?:\\/|$))*$"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9_-]+$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "transport": {
                    "type": "string",
                    "const": "stdio"
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "cwd": {
                    "type": "string",
                    "minLength": 1
                  },
                  "env": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "toolTimeoutSec": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": ["transport", "command"]
              },
              {
                "type": "object",
                "properties": {
                  "transport": {
                    "type": "string",
                    "const": "http"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "headers": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "auth": {
                    "type": "string",
                    "enum": ["oauth", "none"]
                  },
                  "oauth": {
                    "type": "object",
                    "properties": {
                      "clientId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "scopes": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "resource": {
                        "type": "string",
                        "format": "uri"
                      },
                      "callbackPort": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      },
                      "callbackUrl": {
                        "type": "string",
                        "format": "uri"
                      },
                      "clientSecret": {
                        "type": "string"
                      }
                    }
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "toolTimeoutSec": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": ["transport", "url"]
              }
            ]
          }
        }
      ]
    },
    "inputs": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 1024
          },
          "secret": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": ["key", "label"],
        "additionalProperties": false
      }
    },
    "keywords": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "category": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "i18n": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 35,
        "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 1024
          },
          "examples": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "additionalProperties": false
      }
    },
    "examples": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "privacyPolicy": {
      "type": "string",
      "format": "uri"
    },
    "termsOfService": {
      "type": "string",
      "format": "uri"
    },
    "requires": {
      "type": "object",
      "properties": {
        "runtimes": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*(?:(?:>=|=)[0-9][0-9A-Za-z.+-]*)?$"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "id", "name", "version"],
  "additionalProperties": false,
  "title": "Wevir plugin manifest (wevir-plugin.json)"
}
