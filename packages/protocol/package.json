{
  "name": "@wevir/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Wevir Host API: domain types, schemas and protocol version.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@wevir/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema": "node scripts/plugin-schema.ts && biome format --write schemas"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
