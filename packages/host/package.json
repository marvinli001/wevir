{
  "name": "@wevir/host",
  "version": "0.0.0",
  "private": true,
  "description": "Wevir Local Agent Host: event store, replay and session snapshots.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@wevir/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
