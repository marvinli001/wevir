{
  "name": "@wevir/host",
  "version": "0.0.0",
  "private": true,
  "description": "Wevir Local Agent Host: event store, replay, session snapshots, the session manager, the WebSocket JSON-RPC server and the wevir-host executable (EchoAdapter or the Codex adapter).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@wevir/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "@wevir/source": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "wevir-host": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@homebridge/ciao": "1.3.12",
    "@mixmark-io/domino": "2.2.0",
    "@noble/curves": "2.4.0",
    "@wevir/adapter-antigravity": "workspace:*",
    "@wevir/adapter-claude": "workspace:*",
    "@wevir/adapter-codex": "workspace:*",
    "@wevir/adapter-cursor": "workspace:*",
    "@wevir/adapter-devin": "workspace:*",
    "@wevir/adapter-grok": "workspace:*",
    "@wevir/adapter-opencode": "workspace:*",
    "@wevir/adapter-workbuddy": "workspace:*",
    "@wevir/noise": "workspace:*",
    "@wevir/protocol": "workspace:*",
    "@wevir/runtime-adapter": "workspace:*",
    "@wevir/storage": "workspace:*",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "smol-toml": "1.9.1",
    "turndown": "7.2.4",
    "vscode-languageserver-protocol": "3.18.4",
    "ws": "^8.22.0",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0",
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "@types/turndown": "5.0.6",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "3.4.0",
    "@wevir/relay": "workspace:*"
  }
}
