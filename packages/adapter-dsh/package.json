{
  "name": "@wevir/adapter-dsh",
  "version": "0.0.0",
  "private": true,
  "description": "Wevir engine adapter for DeepSeek Harness (dsh): the dsh configuration of the generic ACP adapter, plus dsh's own parts (DSH_HOME, environment, stream-tap incremental output, Provider overlay).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@wevir/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@wevir/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "stream-tap"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@wevir/adapter-acp": "workspace:*",
    "@wevir/runtime-adapter": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.2"
  }
}
