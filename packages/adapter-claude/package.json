{
  "name": "@wevir/adapter-claude",
  "version": "0.0.0",
  "private": true,
  "description": "Wevir engine adapter for Claude Agent: drives the user's own claude CLI and login through the Claude Agent SDK (ported from T3 Code).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@wevir/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "@wevir/runtime-adapter": "workspace:*"
  }
}
