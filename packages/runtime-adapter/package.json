{
  "name": "@wevir/runtime-adapter",
  "version": "0.0.0",
  "private": true,
  "description": "Wevir engine adapter interface, implementation-agnostic contract tests and the EchoAdapter dev engine.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@wevir/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./echo": {
      "@wevir/source": "./src/echo.ts",
      "types": "./dist/echo.d.ts",
      "default": "./dist/echo.js"
    },
    "./history-tool": {
      "@wevir/source": "./src/history-tool.ts",
      "types": "./dist/history-tool.d.ts",
      "default": "./dist/history-tool.js"
    },
    "./app-tools-bridge": {
      "@wevir/source": "./src/app-tools-bridge.ts",
      "types": "./dist/app-tools-bridge.d.ts",
      "default": "./dist/app-tools-bridge.js"
    },
    "./contract": {
      "@wevir/source": "./src/contract.ts",
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vitest": "^5.0.3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
