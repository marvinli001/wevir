{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "epoch": {
          "type": "string",
          "const": "0"
        },
        "state": {
          "type": "string",
          "const": "absent"
        }
      },
      "required": ["runId", "epoch", "state"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "epoch": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,38}$"
        },
        "state": {
          "type": "string",
          "enum": ["held", "released", "expired"]
        }
      },
      "required": ["runId", "epoch", "state"],
      "additionalProperties": false
    }
  ],
  "$id": "urn:wevir:sync:1:r2:executionState"
}
