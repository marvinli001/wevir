{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "opId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "blobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "recordIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "events": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,38})$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": ["seq", "sha256"],
        "additionalProperties": false
      }
    }
  },
  "required": ["opId"],
  "additionalProperties": false,
  "$id": "urn:wevir:sync:1:recordManifest"
}
