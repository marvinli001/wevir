{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "blobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "state": {
      "type": "string",
      "const": "ready"
    }
  },
  "required": ["blobId", "state"],
  "additionalProperties": false,
  "$id": "urn:wevir:sync:1:uploaded"
}
