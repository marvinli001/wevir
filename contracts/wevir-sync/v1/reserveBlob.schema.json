{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "blobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "cipherBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4194304
    },
    "cipherSha256": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "project",
        "session",
        "event-segment",
        "settings",
        "memory",
        "rule",
        "skill-bundle",
        "artifact",
        "workspace-snapshot"
      ]
    }
  },
  "required": ["blobId", "cipherBytes", "cipherSha256", "purpose"],
  "additionalProperties": false,
  "$id": "urn:wevir:sync:1:reserveBlob"
}
