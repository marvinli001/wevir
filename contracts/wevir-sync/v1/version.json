{
  "protocol": "wevir-sync/1",
  "artifactRevision": 1,
  "status": "frozen",
  "interoperability": "unverified",
  "limits": {
    "transferBytesPerSecond": 1048576,
    "transferMs": 15000,
    "transferChunkBytes": 65536,
    "blobBytes": 4194304,
    "headerBytes": 8192,
    "plainBytes": 16777216,
    "expansionRatio": 64,
    "operations": 256,
    "commitBytes": 1048576,
    "parents": 32,
    "changeBytes": 1048576,
    "projects": 1000
  },
  "schemas": [
    "signingKeys",
    "operation",
    "header",
    "pack",
    "entitlements",
    "devices",
    "approved",
    "applied",
    "recoveryCompleted",
    "enrollmentStart",
    "enrollmentStarted",
    "enrollmentPoll",
    "enrollmentPolled",
    "vaultOpen",
    "vaultOpened",
    "scopes",
    "scopesUpdated",
    "approveDevice",
    "unlock",
    "unlocked",
    "reserveBlob",
    "blobReserved",
    "uploaded",
    "recordManifest",
    "commit",
    "commitResult",
    "changes",
    "download",
    "downloadReserved",
    "ack",
    "executionClaim",
    "executionRenew",
    "executionRelease",
    "execution",
    "recoveryRequest",
    "recoveryComplete",
    "recoveryState",
    "recoveryExport",
    "exported",
    "deleteVault",
    "deleted",
    "error",
    "receipt",
    "controlCheckpoint",
    "recoveryBundle"
  ],
  "binary": "uint32be(headerLength) || UTF8(RFC8785(header)) || ciphertext || GCM-tag(16)",
  "aad": "entire canonical header",
  "encodings": "unpadded base64url",
  "compressionOrder": "JSON pack -> gzip/none -> AES-256-GCM",
  "offlineWrapping": {
    "algorithm": "RSA-OAEP-SHA-256",
    "minimumBits": 3072,
    "label": "UTF8(JCS({vaultId,keyEpoch}))"
  },
  "extensions": [
    "commit.recordManifest",
    "changes.recordManifest",
    "vaultOpened.originHostId",
    "packRecord.projectId",
    "packRecord.events",
    "entitlements.vault",
    "ack.restoreId",
    "GET sync/v1/signing-keys",
    "wevir-sync-export/1",
    "wevir-sync-control/1"
  ],
  "license": "MIT"
}
