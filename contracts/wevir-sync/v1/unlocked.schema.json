{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "vaultId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "keyEpoch": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,38})$"
    },
    "keyMaterial": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": ["vaultId", "keyEpoch", "keyMaterial"],
  "additionalProperties": false,
  "$id": "urn:wevir:sync:1:unlocked"
}
