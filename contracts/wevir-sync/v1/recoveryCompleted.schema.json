{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "state": {
      "type": "string",
      "const": "completed"
    },
    "keyEpoch": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,38})$"
    }
  },
  "required": ["requestId", "state", "keyEpoch"],
  "additionalProperties": false,
  "$id": "urn:wevir:sync:1:recoveryCompleted"
}
