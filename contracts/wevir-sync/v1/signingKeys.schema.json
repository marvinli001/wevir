{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "keys": {
      "maxItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "keyId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,128}$"
          },
          "publicKey": {
            "type": "string",
            "minLength": 40,
            "maxLength": 1024
          }
        },
        "required": ["keyId", "publicKey"],
        "additionalProperties": false
      }
    }
  },
  "required": ["keys"],
  "additionalProperties": false,
  "$id": "urn:wevir:sync:1:signingKeys"
}
