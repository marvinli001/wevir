{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "wevir-session/1"
    },
    "recoveredFrom": {
      "type": "object",
      "properties": {
        "vaultId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "deviceId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "opId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "commitId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "source": {
          "type": "object",
          "properties": {
            "hostId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "deviceId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "sessionId": {
              "type": "string",
              "pattern": "^ses_[0-9A-Za-z]{1,64}$"
            },
            "streamId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          },
          "required": ["hostId", "deviceId", "sessionId", "streamId"],
          "additionalProperties": false
        },
        "origin": {
          "type": "object",
          "properties": {
            "hostId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "sessionId": {
              "type": "string",
              "pattern": "^ses_[0-9A-Za-z]{1,64}$"
            },
            "streamId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "fromSeq": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)$"
            },
            "throughSeq": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)$"
            }
          },
          "required": ["hostId", "sessionId", "streamId", "fromSeq", "throughSeq"],
          "additionalProperties": false
        }
      },
      "required": ["vaultId", "deviceId", "opId"],
      "additionalProperties": false
    },
    "sessionId": {
      "type": "string",
      "pattern": "^ses_[0-9A-Za-z]{1,64}$"
    },
    "throughSeq": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,38})$"
    },
    "title": {
      "type": "string",
      "maxLength": 2048
    },
    "titleSource": {
      "type": "string",
      "enum": ["first_prompt", "user", "generated"]
    },
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "engine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "origin": {
      "$ref": "#/$defs/__schema0"
    },
    "source": {
      "type": "object",
      "properties": {
        "hostId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^ses_[0-9A-Za-z]{1,64}$"
        },
        "streamId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        }
      },
      "required": ["hostId", "deviceId", "sessionId", "streamId"],
      "additionalProperties": false
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "side": {
      "type": "boolean",
      "const": true
    },
    "parentSessionId": {
      "type": "string",
      "pattern": "^ses_[0-9A-Za-z]{1,64}$"
    },
    "forkedFrom": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^ses_[0-9A-Za-z]{1,64}$"
        },
        "turnId": {
          "type": "string",
          "pattern": "^trn_[0-9A-Za-z]{1,64}$"
        }
      },
      "required": ["sessionId"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "sessionId",
    "throughSeq",
    "title",
    "titleSource",
    "providerId",
    "modelId",
    "engine",
    "createdAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "urn:wevir:content:1:session"
}
