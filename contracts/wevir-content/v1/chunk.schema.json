{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "wevir-chunk/1"
    },
    "ownerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "data": {
      "type": "string",
      "maxLength": 262144,
      "pattern": "^[A-Za-z0-9_-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": ["schema", "ownerId", "index", "data", "sha256"],
  "additionalProperties": false,
  "$id": "urn:wevir:content:1:chunk"
}
