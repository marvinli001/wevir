{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "wevir-event-stream/1"
    },
    "recoveredFrom": {
      "type": "object",
      "properties": {
        "vaultId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "deviceId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "opId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "commitId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "source": {
          "type": "object",
          "properties": {
            "hostId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "deviceId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "sessionId": {
              "type": "string",
              "pattern": "^ses_[0-9A-Za-z]{1,64}$"
            },
            "streamId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          },
          "required": ["hostId", "deviceId", "sessionId", "streamId"],
          "additionalProperties": false
        },
        "origin": {
          "type": "object",
          "properties": {
            "hostId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "sessionId": {
              "type": "string",
              "pattern": "^ses_[0-9A-Za-z]{1,64}$"
            },
            "streamId": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            },
            "fromSeq": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)$"
            },
            "throughSeq": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)$"
            }
          },
          "required": ["hostId", "sessionId", "streamId", "fromSeq", "throughSeq"],
          "additionalProperties": false
        }
      },
      "required": ["vaultId", "deviceId", "opId"],
      "additionalProperties": false
    },
    "sessionId": {
      "type": "string",
      "pattern": "^ses_[0-9A-Za-z]{1,64}$"
    },
    "streamId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "exclusions": {
      "maxItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "const": "engine.raw"
      }
    }
  },
  "required": ["schema", "sessionId", "streamId", "exclusions"],
  "additionalProperties": false,
  "$id": "urn:wevir:content:1:event-stream"
}
