{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "wevir-workspace-snapshot/1"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "hostId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^ses_[0-9A-Za-z]{1,64}$"
        },
        "streamId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        }
      },
      "required": ["hostId", "deviceId", "sessionId", "streamId"],
      "additionalProperties": false
    },
    "throughSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceHead": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "base": {
      "type": "string",
      "const": "bounded-tree"
    },
    "statusHash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "selectedUntracked": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "ruleVersions": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entityId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,128}$"
          },
          "opId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,128}$"
          }
        },
        "required": ["entityId", "opId"],
        "additionalProperties": false
      }
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "schema",
    "projectId",
    "source",
    "throughSeq",
    "sourceHead",
    "base",
    "statusHash",
    "selectedUntracked",
    "ruleVersions",
    "capturedAt"
  ],
  "additionalProperties": false,
  "$id": "urn:wevir:content:1:workspace"
}
