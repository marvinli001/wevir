{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "wevir-bundle/1"
    },
    "category": {
      "type": "string",
      "enum": ["rule", "skill-bundle", "artifact", "workspace-snapshot"]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "files": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "parts": {
            "maxItems": 1024,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entityId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{8,128}$"
                },
                "opId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{8,128}$"
                }
              },
              "required": ["entityId", "opId"],
              "additionalProperties": false
            }
          },
          "executable": {
            "type": "boolean"
          }
        },
        "required": ["path", "bytes", "sha256", "parts"],
        "additionalProperties": false
      }
    },
    "exclusions": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "metadata": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": ["schema", "category", "name", "files", "exclusions"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "urn:wevir:content:1:bundle"
}
