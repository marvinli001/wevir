{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "wevir-memory/1"
    },
    "scope": {
      "type": "string",
      "enum": ["global", "project"]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "markdown": {
      "type": "string",
      "maxLength": 131072
    },
    "deleted": {
      "type": "boolean"
    }
  },
  "required": ["schema", "scope", "name"],
  "additionalProperties": false,
  "$id": "urn:wevir:content:1:memory"
}
