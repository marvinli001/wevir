+//#region src/utils/diffsText.ts
+// Wevir 的补丁：分隔条上的文字（“N 行未修改”等）原来写死成英文，改成可以由使用方换掉（setDiffsText）。
+const EN_PLURAL_RULES = new Intl.PluralRules("en-US");
+const diffsText = {
+	unmodifiedLines: (lines) => `${lines} unmodified line${EN_PLURAL_RULES.select(lines) === "one" ? "" : "s"}`,
+	moreContext: "More unchanged context may be available",
+	expandAll: "Expand all"
+};
+function setDiffsText(text) {
+	Object.assign(diffsText, text);
+}
+//#endregion
+export { diffsText, setDiffsText };
