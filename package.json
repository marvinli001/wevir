{
  "name": "wevir",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first, open-source, multi-model Agent workbench.",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel --if-present dev",
    "wevir": "node apps/cli/dist/main.js",
    "dev:host": "pnpm --filter \"@wevir/host...\" build && node packages/host/dist/main.js --home ./.wevir-dev --adapter echo",
    "lint": "biome check . && node scripts/check-engine-boundary.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "gate:m2": "pnpm --filter \"@wevir/host...\" build && node scripts/gate-m2.ts",
    "icons:build": "node scripts/icons/export.mjs && node scripts/icons/preview.mjs && biome format --write assets/icons",
    "icons:check": "node scripts/icons/verify.mjs",
    "icons:pack": "node scripts/icons/pack.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "sharp": "0.35.5",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
