{
  "name": "@wevir/cli",
  "version": "0.0.0",
  "private": true,
  "description": "wevir command-line client: start and stop the local Host, manage workspaces and providers, create sessions and attach to them with live output and interactive approvals.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "wevir": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@wevir/client-sdk": "workspace:*",
    "@wevir/host": "workspace:*",
    "@wevir/noise": "workspace:*",
    "@wevir/protocol": "workspace:*",
    "mute-stream": "3.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/mute-stream": "0.0.4",
    "@types/ws": "^8.18.2",
    "@wevir/relay": "workspace:*",
    "@wevir/runtime-adapter": "workspace:*"
  }
}
