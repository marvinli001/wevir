{
  "name": "@wevir/relay-worker",
  "version": "0.0.0",
  "private": true,
  "description": "The Wevir relay on Cloudflare Workers and Durable Objects: wire-compatible with apps/relay, forwards opaque Noise ciphertext and never decrypts, stores or logs frame contents.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist && node scripts/licenses.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run"
  },
  "dependencies": {
    "@wevir/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/ws": "^8.18.2",
    "@wevir/relay": "workspace:*",
    "miniflare": "5.20261019.0-beta",
    "wrangler": "4.151.2",
    "ws": "^8.22.0"
  }
}
