{
  "name": "@wevir/desktop",
  "productName": "Wevir",
  "version": "0.0.0",
  "private": true,
  "description": "Wevir desktop shell (Electron + React): discovers or launches the local Host and connects the renderer to it.",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm --filter \"@wevir/host...\" build && install-electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/renderer && tsc --noEmit -p src/renderer/tsconfig.test.json",
    "resources": "node scripts/stage-resources.ts",
    "package": "node scripts/package.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@pierre/diffs": "1.5.1",
    "@shikijs/transformers": "4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "4.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@wevir/client-sdk": "workspace:*",
    "@wevir/host": "workspace:*",
    "@wevir/protocol": "workspace:*",
    "@wevir/runtime-adapter": "workspace:*",
    "border-beam": "1.4.1",
    "bot-avatars": "0.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dompurify": "^3.4.16",
    "electron": "^44.7.0",
    "electron-builder": "26.17.0",
    "electron-updater": "6.8.10",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "htmlparser2": "8.0.2",
    "img-fx": "0.5.1",
    "js-yaml": "4.3.2",
    "katex": "0.18.10",
    "liquid-gooey": "0.2.2",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.0",
    "marked-katex-extension": "5.1.13",
    "mermaid": "11.17.2",
    "metal-fx": "2.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "semver": "7.7.4",
    "shiki": "4.4.3",
    "tailwindcss": "^4.3.3",
    "thinking-orbs": "0.3.2",
    "three": "0.186.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.7"
  }
}
