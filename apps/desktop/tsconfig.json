{
  // 主进程、preload、共用模块、配置、脚本与测试。渲染进程另有 src/renderer/tsconfig.json。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // electron-vite/node 声明 ?asset 等导入后缀（主进程的应用图标，src/main/app-icon.ts）。
    "types": ["node", "electron-vite/node"],
    "noEmit": true,
    // scripts/ 里的脚本由 node 直接运行（类型擦除），互相导入时要写 .ts 后缀（scripts/package.ts）。
    "allowImportingTsExtensions": true
  },
  "include": ["src/main", "src/preload", "src/shared", "scripts", "*.config.ts"]
}
