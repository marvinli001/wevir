# 依赖与构建产物
node_modules/
dist/
# electron-vite 的构建产物（apps/desktop）
out/
# 随安装包分发的运行时（apps/desktop 的 pnpm resources 准备，ADR-0007 决策 5）
/apps/desktop/resources/
# 安装包（apps/desktop 的 pnpm package，electron-builder 的输出目录）
/apps/desktop/release/
coverage/
*.tsbuildinfo
# 图标交付 ZIP 可从已跟踪的源文件与导出脚本重建。
/assets/icons/release/

# 上游只读克隆（scripts/upstream-sync.sh 生成）
/upstream/

# 本地运行时数据
.wevir-dev/
# 一次性验证代码只在本机，不进仓库
/spikes/

# 维护者给的界面参考截图（Codex、Claude Code 桌面端，第三方产品的界面）与视觉方向稿，只在本机
/design-refs/
packages/adapter-codex/.test-outside/
packages/host/.test-outside/

# 密钥与本地环境
.env
.env.*
!.env.example

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 编辑器与系统
.DS_Store
Thumbs.db
.idea/

# 内部开发文档只在维护者本机，不进公开仓库：docs/ 里只有 upstream/（NOTICE 引用的上游登记与第三方声明）公开。
# 要公开新的文档时用 git add -f。
/docs/*
!/docs/upstream/
